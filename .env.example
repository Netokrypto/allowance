# The judge demo does not need any of these.
# Copy to .env only if you add a key yourself. Never commit .env.

# Optional partner JWT for 1Click. Without it, dry quotes still work.
# ONE_CLICK_API_KEY=

# Local server port. Vercel ignores this.
# PORT=3000

# Testnet contract. The agent key is a function-call key for execute only.
# CONTRACT_ID=netokrypto-allowance.testnet
# AGENT_PRIVATE_KEY=
